PORT=3001
APP_SECRET=replace-this-in-production
# 后台管理登录密码。生产环境必须与 APP_SECRET 分离，长度至少 20 位；
# 未设置时会临时使用 ACTIVATION_ADMIN_SECRET，建议上线后改为独立密码。
# ADMIN_CONSOLE_PASSWORD=replace-with-a-separate-random-password
DEV_EMAIL_CODES=true
CORS_ORIGIN=http://localhost:5173

# 真实邮件发送。QQ 邮箱 SMTP 示例：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sender@qq.com
# SMTP_PASS=QQ邮箱生成的SMTP授权码（不是登录密码）
# SMTP_FROM=offerGet <your-sender@qq.com>

# 百炼 Fun-ASR 实时语音识别（仅保存在服务器）：
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# DASHSCOPE_ASR_MODEL=fun-asr-realtime
# DASHSCOPE_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# 硅基流动截图视觉模型（仅保存在服务器）：
# SILICONFLOW_API_KEY=sk-xxxxxxxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# SILICONFLOW_VISION_TIMEOUT_MS=90000
# SILICONFLOW_IMAGE_DETAIL=high
# SILICONFLOW_VISION_TIMEOUT_MS=45000
